# Trusted Routebook server configuration.
# Every variable below is read by the server (server.mjs / server/config) unless it is marked "reserved".
# Numeric values fall back to the documented default when unset.

# --- Model runtime -----------------------------------------------------------
# Explicit AI runtime (required in production).
AI_PROVIDER=yinyue
OPENAI_BASE_URL=https://example-openai-compatible-host
OPENAI_API_KEY=replace-with-server-side-key
OPENAI_MODEL=gpt-5.5
# Supported values: responses, chat_completions (domestic providers: chat_completions).
OPENAI_WIRE_API=responses
# domestic | overseas. Production warns unless domestic (docs/domestic-model-provider.md).
# AI_PROVIDER_REGION=domestic
AI_TIMEOUT_MS=120000
# AI_MAX_OUTPUT_TOKENS=6000
# AI_MAX_OUTPUT_TOKENS_RETRY=12000
# OCR_MAX_OUTPUT_TOKENS=4000
# Reading the local Codex CLI config (~/.codex) is a development convenience only.
# Default: true for `npm run dev`, false for `npm start` (production). Env vars above win.
# AI_RUNTIME_FROM_CODEX=false
# Codex config locations (defaults to ~/.codex/config.toml and ~/.codex/auth.json).
# CODEX_HOME=~/.codex
# CODEX_CONFIG_PATH=~/.codex/config.toml
# CODEX_AUTH_PATH=~/.codex/auth.json

# Optional server-side POI geocoding. Without this key, model coordinates stay fuzzy and navigation is disabled.
# Stop names are resolved with AMap POI search (/v3/place/text, several candidates, deterministic
# name-match chooser) and fall back to address geocoding (/v3/geocode/geo). The chosen precision
# (poi-exact / poi-name-match / address / road / approximate) widens the check-in arrival radius
# by at most 250 m; approximate results never count as arrivals.
# AMAP_GEOCODE_KEY=replace-with-amap-web-service-key
# GEOCODE_TIMEOUT_MS=5000
# Override only for tests / a mock server.
# AMAP_API_BASE_URL=https://restapi.amap.com

# Generation guard: identical requests within the TTL share one result (per process);
# signed-in profiles get at most GENERATION_QUOTA_PER_PROFILE generations per window (0 = off).
# Anonymous callers stay on the per-IP rate limit.
# GENERATION_DEDUP_TTL_MS=600000
# GENERATION_QUOTA_PER_PROFILE=30
# GENERATION_QUOTA_WINDOW_MS=86400000

# --- HTTP server -------------------------------------------------------------
# Server defaults are local-only to avoid exposing the model proxy on LAN.
HOST=127.0.0.1
PORT=5173
# REQUEST_TIMEOUT_MS=130000
# HEADERS_TIMEOUT_MS=15000
# Max time to wait for in-flight requests after SIGTERM/SIGINT before exiting.
# SHUTDOWN_GRACE_MS=10000
# Canonical public origin used for absolute og:image URLs on /share and /review pages.
# Recommended in production; without it the (validated) Host header is used.
# PUBLIC_BASE_URL=https://routebook.example.com
# Dev-only Vite HMR websocket port (first free port from here is used).
# VITE_HMR_PORT=24679
# Only used by `npm run dev:frontend` (standalone Vite on 5174) to proxy /api.
# VITE_API_PROXY_TARGET=http://127.0.0.1:5173

# --- Storage -----------------------------------------------------------------
ROUTEBOOK_DATA_DIR=./data
# JSONL uses an exclusive runtime-writer lease; only one process may write DATA_DIR.
# PostgreSQL is optional. Run migrate -> backfill -> parity before switching.
STORAGE_BACKEND=jsonl
# DATABASE_URL=postgresql://routebook_app:replace-with-password@127.0.0.1:5432/trusted_routebook
# POSTGRES_POOL_MAX=10
# POSTGRES_CONNECT_TIMEOUT_MS=5000
# POSTGRES_STATEMENT_TIMEOUT_MS=15000
# POSTGRES_IDLE_TRANSACTION_TIMEOUT_MS=15000
# BACKUP_ENCRYPTION_KEY=<strong-secret-at-least-16-UTF8-bytes>

# Real road directions (never infer verification from a basemap or straight line).
# Uses AMAP_GEOCODE_KEY if AMAP_ROUTING_KEY is absent. No key -> unverified.
# AMAP_ROUTING_KEY=
ROUTING_TIMEOUT_MS=8000
ROUTING_CONCURRENCY=3

# Optional operator-supplied price snapshot; never used without reported usage.
# AI_INPUT_COST_PER_MILLION_TOKENS=
# AI_OUTPUT_COST_PER_MILLION_TOKENS=
# AI_COST_CURRENCY=USD

# --- Request limits ----------------------------------------------------------
MAX_JSON_BODY_BYTES=1048576
# OCR is the only endpoint allowed to exceed the normal JSON limit. The default
# fits four 2 MiB images after base64 expansion while keeping other writes small.
MAX_OCR_REQUEST_BYTES=11272192
MAX_OCR_IMAGES=4
MAX_OCR_IMAGE_BYTES=2097152
MAX_GUIDE_CHARS=20000
# MAX_ROUTEBOOK_STOPS=40
# MAX_CHECKIN_PHOTO_BYTES=2097152
# CHECKIN_PHOTO_QUOTA_MAX=60

# Link import (public pages only; private/loopback targets are always refused).
# MAX_IMPORT_URLS=5
# MAX_IMPORT_PAGE_BYTES=524288
# IMPORT_TIMEOUT_MS=12000

# --- Rate limits (per client IP, per window) -----------------------------------
RATE_LIMIT_WINDOW_MS=60000
# AI endpoints and uncategorised writes.
RATE_LIMIT_MAX=12
# RATE_LIMIT_CORE_WRITE_MAX=24
# RATE_LIMIT_PUBLIC_READ_MAX=60
# Cheap public config reads: /api/cities, /api/cms, /api/products.
# RATE_LIMIT_PUBLIC_CONFIG_MAX=240
# RATE_LIMIT_TELEMETRY_MAX=60
# RATE_LIMIT_MAP_TILE_MAX=300
# Read-only ops listings (review queue, check-ins, imports, audits).
# RATE_LIMIT_OPS_READ_MAX=120

# Same-origin basemap tile proxy (/api/map-tiles). Tiles are cached in memory,
# providers are tried in order, and placeholder tiles served with HTTP 200
# (e.g. "API KEY REQUIRED" images, HTML error pages) are detected and skipped.
#
# Providers: tianditu | amap | osm-de | osm-fr | osm
# Default: tianditu first when TIANDITU_KEY is set, then the keyless OSM mirrors
# osm-de, osm-fr (fine for local development; not for production traffic).
# MAP_TILE_PROVIDERS=tianditu,osm-de,osm-fr
#
# 天地图 (recommended for production in China, WGS-84 compatible): apply for a
# "服务端" key at https://console.tianditu.gov.cn and allow the server's egress IP.
# TIANDITU_KEY=replace-with-tianditu-server-key
#
# 高德 tiles are GCJ-02; the browser shifts markers automatically, and the list is
# never mixed with WGS-84 providers. Commercial use needs an AMap licence.
# MAP_TILE_PROVIDERS=amap
# AMAP_TILE_KEY=replace-with-amap-key
#
# Skip a provider for this long after it serves placeholders.
# MAP_TILE_PROVIDER_COOLDOWN_MS=600000
MAP_TILE_TIMEOUT_MS=12000
MAP_TILE_UPSTREAM_TIMEOUT_MS=4000
MAP_TILE_CACHE_MAX_ENTRIES=600
MAP_TILE_MAX_BYTES=1048576

# --- Trust scoring / check-in plausibility -------------------------------------
# TRUST_FEEDBACK_SAMPLE_TARGET=12
# POI_FEEDBACK_WINDOW_DAYS=30
# CHECKIN_TRUSTED_ACCURACY_METERS=200
# CHECKIN_MAX_REPORTED_ACCURACY_METERS=500
# CHECKIN_MAX_PLAUSIBLE_KMH=300
# CHECKIN_PLAUSIBILITY_WINDOW_HOURS=12

# --- Access control ------------------------------------------------------------
# Only enable these when intentionally exposing the API beyond localhost.
# ALLOW_PUBLIC_MODEL_PROXY=true
# ROUTEBOOK_API_TOKEN=replace-with-random-token
# Production defaults do not trust localhost reverse-proxy requests automatically.
# Set these only for a private local demo, never for an internet-facing deployment.
# ALLOW_LOCAL_API_BYPASS=true
# ALLOW_LOCAL_ADMIN_BYPASS=true
# Production refuses to start when a bypass is enabled on a non-loopback HOST unless this is set.
# ALLOW_LOCAL_BYPASS_ON_PUBLIC_HOST=true

# Admin writes use a separate token from the public API token.
# Localhost can write ops data by default; enable REQUIRE_LOCAL_ADMIN_TOKEN for stricter local demos.
# ROUTEBOOK_ADMIN_TOKEN=replace-with-separate-admin-token
# REQUIRE_LOCAL_ADMIN_TOKEN=true
# The browser UI reads admin tokens from sessionStorage, not from a Vite build-time env var.
# HMAC secret for profile ids and profile token hashes. Set it explicitly; the legacy
# fallback to ROUTEBOOK_ADMIN_TOKEN / ROUTEBOOK_API_TOKEN is deprecated (see README migration).
# PROFILE_ID_SECRET=replace-with-random-server-side-secret
# PROFILE_IDENTITY_ASSERTION_SECRET signs verified phone/WeChat assertions from a real login backend.
# PROFILE_IDENTITY_ASSERTION_SECRET=replace-with-login-assertion-secret
# Do not expose ROUTEBOOK_API_TOKEN as a VITE_* build variable; browser bundles are public.

# Only trust X-Forwarded-For when a known reverse proxy terminates traffic in front of this service.
# TRUST_PROXY_HEADERS=true
# Comma-separated proxy addresses / IPv4 CIDRs whose X-Forwarded-For is trusted.
# TRUSTED_PROXY_CIDRS=127.0.0.1,::1

# --- Compliance (docs/compliance.md) -------------------------------------------
# Content moderation for public user text: keyword (default) | domestic | none.
# MODERATION_PROVIDER=keyword
# One entry per line: block:词 / review:词 / 词 (= review). # starts a comment.
# MODERATION_KEYWORDS_FILE=/etc/routebook/moderation-keywords.txt
# Domestic content-safety adapter (stub contract; map it to your vendor first).
# MODERATION_API_URL=
# MODERATION_API_KEY=
# MODERATION_TIMEOUT_MS=3000
# Production refuses OSM basemaps; set TIANDITU_KEY or AMAP_TILE_KEY. Override only for private demos.
# ALLOW_OSM_BASEMAP_IN_PRODUCTION=false
