{
  "name": "trusted-routebook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.mjs",
    "dev:frontend": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/move-sourcemaps.mjs",
    "start": "node --env-file-if-exists=.env server.mjs --production",
    "check:syntax": "node scripts/check-syntax.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke:api": "node --env-file-if-exists=.env scripts/smoke-api.mjs",
    "test": "npm run test:unit",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:security": "node scripts/security-regression.mjs",
    "test:profile-migration": "node scripts/profile-migration-regression.mjs",
    "test:checkin-queue": "node scripts/checkin-queue-regression.mjs",
    "test:p0": "node scripts/p0-regression.mjs",
    "test:w3-w5": "node scripts/w3-w5-regression.mjs",
    "test:postgres-schema": "node scripts/postgres-schema-regression.mjs",
    "test:postgres-storage": "node scripts/postgres-storage-regression.mjs && node scripts/accounts-store-regression.mjs",
    "test:postgres-runtime": "node scripts/postgres-runtime-regression.mjs",
    "test:backup": "node scripts/backup-restore-regression.mjs && node scripts/backup-coordination-regression.mjs",
    "test:storage-safety": "node scripts/postgres-snapshot-security-regression.mjs && node scripts/source-coordination-regression.mjs && node scripts/source-lease-recovery-regression.mjs && node scripts/runtime-writer-lease-regression.mjs",
    "test:profile-trip": "node scripts/profile-trip-regression.mjs",
    "test:pwa-build": "node scripts/pwa-build-regression.mjs",
    "backup:data": "node --env-file-if-exists=.env scripts/backup-data.mjs",
    "restore:data": "node --env-file-if-exists=.env scripts/restore-data.mjs",
    "postgres:migrate": "node --env-file-if-exists=.env scripts/postgres-migrate.mjs",
    "postgres:backfill": "node --env-file-if-exists=.env scripts/postgres-backfill.mjs",
    "postgres:parity": "node --env-file-if-exists=.env scripts/postgres-parity.mjs",
    "postgres:export": "node --env-file-if-exists=.env scripts/postgres-export-jsonl.mjs",
    "source:lease": "node scripts/source-lease.mjs",
    "verify": "npm run check:syntax && npm run lint && npm run format:check && npm run typecheck && npm run build && npm run test:unit && npm run test:security && npm run test:profile-migration && npm run test:checkin-queue && npm run test:p0 && npm run test:w3-w5 && npm run test:profile-trip && npm run test:storage-safety && npm run test:backup && npm run test:pwa-build",
    "verify:full": "npm run verify && npm run smoke:api",
    "preview": "npm run build && npm run start",
    "poi:dedup-report": "node scripts/poi-dedup-report.mjs",
    "eval:generation": "node scripts/eval/run-generation-eval.mjs",
    "jev:labeling-kit": "node scripts/jev/build-labeling-kit.mjs",
    "jev:eval": "node scripts/jev/eval-labels.mjs",
    "admin:create": "node --env-file-if-exists=.env scripts/admin-create.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.561.0",
    "nodemailer": "10.0.16",
    "pg": "^8.16.3",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
