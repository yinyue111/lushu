# 生产 app.env 模板（复制为部署目录下的 app.env，chmod 600，不要提交）。说明见 docs/deploy.md。
# 数据库密码不在这里：owner 和应用角色的密码在 compose 用的 .env（docs/deploy.compose.env.example）。
# ---- 必填 ----
# ≥32 位随机串；上线后不要再换（换了旧用户凭证全部失效）
PROFILE_ID_SECRET=
# 运营后台令牌
ROUTEBOOK_ADMIN_TOKEN=
# 生成访问码（用户在「高级设置」填写）
ROUTEBOOK_API_TOKEN=
# 允许带访问码的公网用户调用模型
ALLOW_PUBLIC_MODEL_PROXY=true
AI_PROVIDER=aiwuq
AI_PROVIDER_REGION=overseas
OPENAI_BASE_URL=https://t.aiwuq.cn/v1
OPENAI_WIRE_API=chat_completions
OPENAI_MODEL=grok-4.7
OPENAI_API_KEY=
MAP_TILE_PROVIDERS=amap
AMAP_TILE_KEY=
# 高德 Web 服务 key（地点定位）
AMAP_GEOCODE_KEY=
# 可留空，默认沿用 AMAP_GEOCODE_KEY
# AMAP_ROUTING_KEY=
# 反代来源：compose 网桥网关 + 本机。改了 compose 的 subnet/gateway 要同步改这里（compose 不再覆盖它）
TRUSTED_PROXY_CIDRS=172.31.80.1,127.0.0.1,::1
PUBLIC_BASE_URL=https://lushu.aiwuq.cn
PUBLIC_PUBLISHING=disabled
IMPORTED_ROUTEBOOK_PUBLIC_POLICY=unlisted-only
GENERATION_QUOTA_PER_PROFILE=5
GENERATION_QUOTA_WINDOW_MS=86400000
JEV_SHADOW_ENABLED=true
# 由 SRE 填写
TYPESAFE_API_KEY=
# ---- 账号（手机号 + 密码登录），上线步骤见 docs/login-rollout.md ----
# access-code（默认，和现在一样）| both（登录或访问码都能生成）| login（只认登录）
AUTH_MODE=access-code
# open | invite（内测：注册要邀请码）| closed
# 内测默认开放注册；要恢复邀请制改为 invite
REGISTRATION_MODE=open
# 邀请码；留空时只认后台创建的邀请码（不再沿用 ROUTEBOOK_API_TOKEN）
# REGISTRATION_INVITE_CODE=
# 手机号查找用的 HMAC 密钥：≥32 位随机串。AUTH_MODE 不是 access-code 时必填。
# 务必离线备份！丢了或换了，所有账号都找不到（只能逐个重新注册）。
AUTH_PHONE_HASH_SECRET=
# 邮箱查找用的 HMAC 密钥：≥32 位随机串。AUTH_MODE 不是 access-code 时必填。务必离线备份（同上）。
AUTH_EMAIL_HASH_SECRET=
# 邮箱加密密钥（AES-256-GCM）：≥32 位随机串。必填。丢了就读不出邮箱、发不了信（账号还能用手机号/恢复码登录）。
AUTH_EMAIL_ENC_KEY=
# 发信：smtp（自己的邮件服务器）| resend（Resend HTTP API）| log（只记日志，不发）| file（写到 /data/mail-outbox，只用于测试）| disabled
MAIL_TRANSPORT=disabled
# 发件人，例如：路书 <no-reply@mail.example.com>（域名要配好 SPF/DKIM）
# MAIL_FROM=
# MAIL_API_KEY=
# 其他兼容 Resend 接口的服务可改地址
# MAIL_API_URL=https://api.resend.com/emails
# ---- MAIL_TRANSPORT=smtp 时 ----
# 邮件服务器地址。应用跑在容器里，localhost 指的是容器自己：同机的邮件服务器用它的域名，或 host.docker.internal
# MAIL_SMTP_HOST=
# starttls（默认，587，必须升级成加密）| tls（465，一连上就加密）| none（不加密，只允许 localhost）
# MAIL_SMTP_SECURE=starttls
# 不填时按上面取 587 / 465 / 25
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=
# MAIL_SMTP_PASS=
# 证书校验默认开着；生产不允许设 false。邮件服务器用自签/内部 CA 时，把 CA 证书（PEM）挂进容器并填路径
# MAIL_SMTP_CA_FILE=/run/secrets/mail-ca.pem
# MAIL_SMTP_TLS_VERIFY=true
# 连接/握手超时（毫秒），超时后用户看到「邮件没发出去，稍后再试」
# MAIL_SMTP_TIMEOUT_MS=15000
# none 想发到内网 IP（如 Docker 网桥网关上的宿主机 Postfix）时必须显式打开；公网地址和主机名一律拒绝
# MAIL_SMTP_ALLOW_PLAINTEXT_PRIVATE=false
# 生产现状（宿主机 Postfix 中继，再经 Gmail 发出）：
# MAIL_TRANSPORT=smtp
# MAIL_SMTP_HOST=172.31.80.1
# MAIL_SMTP_PORT=25
# MAIL_SMTP_SECURE=none
# MAIL_SMTP_ALLOW_PLAINTEXT_PRIVATE=true
# MAIL_FROM=路书 <drumyinyue@gmail.com>
# 注册是否必须验证邮箱。发信没配好时设 false（账号照建，邮箱标「未验证」，之后补验证）。
EMAIL_VERIFICATION_REQUIRED=false
# 同一邮箱两次验证码最短间隔（秒）
# EMAIL_CODE_RESEND_SECONDS=60
# 会话：空闲 30 天过期，最长 90 天必须重新登录
# AUTH_SESSION_TTL_DAYS=30
# AUTH_SESSION_MAX_DAYS=90
# 注册/找回的人机检查强度（工作量证明位数，0 关闭；默认 16）
# AUTH_POW_DIFFICULTY=16
# 同时进行的密码哈希数（每个约 32 MB 内存；默认 2）
# AUTH_SCRYPT_CONCURRENCY=2
# 可选：密码哈希额外密钥。设了就不能再改，否则所有人要用恢复码重设密码。
# AUTH_PASSWORD_PEPPER=
# ---- 可选（默认值即可）----
# 一次生成的总时长上限（毫秒，含所有模型调用）
# AI_TIMEOUT_MS=300000
# 单次模型调用上限，默认同上
# AI_CALL_TIMEOUT_MS=300000
# 生成方式：轻快（fast，默认）/ 细品（deep）
# GENERATION_DEFAULT_MODE=fast
# Gemini 的思考档位看后缀：-low / -medium / -high
AI_MODEL_FAST=gemini-3.8-flash-high
# 细品，空＝OPENAI_MODEL
AI_MODEL_DEEP=grok-4.7
AI_TIMEOUT_MS_FAST=120000
# reasoning_effort（low|medium|high|xhigh）；轻快留空（Gemini 档位看后缀）
# AI_REASONING_EFFORT_FAST=
AI_REASONING_EFFORT_DEEP=xhigh

# 联网补全：登录用户路书的景点门票 / 开放时间，两个独立来源一致才显示（docs/deploy.md「联网补全」）
# 内测必须开：不开的话门票和开放时间永远是「待确认」
ENRICH_ENABLED=true
ENRICH_DAILY_BUDGET_USD=30
# ENRICH_MODEL=grok-4.7
# ENRICH_MAX_SEARCHES_PER_ROUTEBOOK=12
# ENRICH_MAX_USD_PER_ROUTEBOOK=1.5
# ENRICH_CACHE_DAYS=7
# ENRICH_CONCURRENCY=2
AI_TIMEOUT_MS_DEEP=480000
# AI_MAX_OUTPUT_TOKENS_FAST=12000
# AI_MAX_OUTPUT_TOKENS_DEEP=12000
# 流式读取 + 无输出超时
# AI_STREAM=true
# AI_STREAM_IDLE_MS_FAST=30000
# AI_STREAM_IDLE_MS_DEEP=150000
# 细品单独上限（0＝只用共享额度）
# GENERATION_QUOTA_DEEP_PER_PROFILE=0
# REQUEST_TIMEOUT_MS=390000
# GENERATION_MAX_ACTIVE_JOBS=2
# JEV_SHADOW_SAMPLE_RATE=1
# JEV_SHADOW_TIMEOUT_MS=800
# PROFILE_IDENTITY_ASSERTION_SECRET=

# 内测成本与范围兜底
GENERATION_DAILY_LIMIT=300
GENERATION_REGION=jzh

# 告警（可选）：日生成上限、补全预算用完、前端错误激增时 POST JSON，同类每小时最多一次
# ALERT_WEBHOOK_URL=https://example.com/hook

# ---- 管理后台 ----
# ADMIN_ENABLED=true 时必填，≥32 位（openssl rand -hex 32），上线后不要换（换了管理员动态码和已存密钥全部失效）
# ADMIN_ENABLED=false
# CONFIG_ENC_KEY=
# 备用模型：默认 fast（细品失败改用轻快）；none 关闭；写错会拒绝启动
# AI_MODEL_FALLBACK_ORDER=
