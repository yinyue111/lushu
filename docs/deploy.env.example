# 生产 .env 模板（复制为部署目录下的 .env，chmod 600，不要提交）。说明见 docs/deploy.md。
# ---- 必填 ----
# 只用 [A-Za-z0-9]，会拼进 DATABASE_URL
POSTGRES_PASSWORD=
# ≥32 位随机串；上线后不要再换（换了旧用户凭证全部失效）
PROFILE_ID_SECRET=
# 运营后台令牌
ROUTEBOOK_ADMIN_TOKEN=
# 生成访问码（用户在「高级设置」填写）
ROUTEBOOK_API_TOKEN=
# 允许带访问码的公网用户调用模型
ALLOW_PUBLIC_MODEL_PROXY=true
AI_PROVIDER=aiwuq
AI_PROVIDER_REGION=overseas
OPENAI_BASE_URL=https://t.aiwuq.cn/v1
OPENAI_WIRE_API=chat_completions
OPENAI_MODEL=grok-4.7
OPENAI_API_KEY=
MAP_TILE_PROVIDERS=amap
AMAP_TILE_KEY=
# 高德 Web 服务 key（地点定位）
AMAP_GEOCODE_KEY=
# 可留空，默认沿用 AMAP_GEOCODE_KEY
# AMAP_ROUTING_KEY=
PUBLIC_BASE_URL=https://lushu.aiwuq.cn
PUBLIC_PUBLISHING=disabled
IMPORTED_ROUTEBOOK_PUBLIC_POLICY=unlisted-only
GENERATION_QUOTA_PER_PROFILE=5
GENERATION_QUOTA_WINDOW_MS=86400000
JEV_SHADOW_ENABLED=true
# 由 SRE 填写
TYPESAFE_API_KEY=
# ---- 可选（默认值即可）----
# AI_TIMEOUT_MS=300000
# REQUEST_TIMEOUT_MS=390000
# GENERATION_MAX_ACTIVE_JOBS=2
# JEV_SHADOW_SAMPLE_RATE=1
# JEV_SHADOW_TIMEOUT_MS=800
# PROFILE_IDENTITY_ASSERTION_SECRET=
